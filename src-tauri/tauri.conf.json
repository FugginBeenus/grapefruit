{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Grapefruit",
  "version": "2.2.1",
  "identifier": "com.grapefruit.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Grapefruit",
        "width": 960,
        "height": 680,
        "minWidth": 800,
        "minHeight": 550,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/grapefruit-sidecar"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
